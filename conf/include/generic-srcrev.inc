def srcrev_for_branch(d, default_rev):
    branch = d.getVar('PROJECT_BRANCH', True) or ''
    distro_features = d.getVar('DISTRO_FEATURES', True) or ''

    if 'custom_branch_verification' in distro_features:
        return '${AUTOREV}'
    if 'sprint' in branch:
        return '${AUTOREV}'
    return default_rev


+static int get_ignite_configs_from_factory_nvram(const char *file,
+						 const char *pattern, char delim,
+						 int field_num, char *out,
+						 size_t out_size)
+{
+	FILE       *fp;
+	char        line[256];
+	int         found = 0;
+	int         ret   = -1;
+
+	if (!file || !pattern || !out || out_size == 0 || field_num < 1)
+		return -1;
+
+	out[0] = '\0';
+
+	fp = fopen(file, "r");
+	if (!fp) {
+		wpa_printf(MSG_ERROR,
+			   "EAP-TTLS-IGNITE: cannot open '%s': %s",
+			   file, strerror(errno));
+		return -1;
+	}
+
+	while (!found && fgets(line, sizeof(line), fp) != NULL) {
+		const char *p;
+		const char *field_start;
+		const char *field_end;
+		int         field_idx;
+		size_t      val_len;
+
+		if (os_strstr(line, pattern) == NULL)
+			continue;
+
+		p         = line;
+		field_idx = 1;
+
+		while (field_idx < field_num) {
+			p = os_strchr(p, delim);
+			if (!p) {
+				wpa_printf(MSG_ERROR,
+					   "EAP-TTLS-IGNITE: pattern '%s': "
+					   "field %d not found (delim='%c')",
+					   pattern, field_num, delim);
+				goto done;
+			}
+			p++;
+			field_idx++;
+		}
+
+		field_start = p;
+
+		while (*field_start == ' ' || *field_start == '\t')
+			field_start++;
+
+		field_end = field_start;
+		while (*field_end &&
+		       *field_end != delim &&
+		       *field_end != '\n' &&
+		       *field_end != '\r')
+			field_end++;
+
+		while (field_end > field_start &&
+		       (*(field_end - 1) == ' ' || *(field_end - 1) == '\t'))
+			field_end--;
+
+		val_len = (size_t)(field_end - field_start);
+
+		if (val_len == 0) {
+			wpa_printf(MSG_ERROR,
+				   "EAP-TTLS-IGNITE: pattern '%s': "
+				   "field %d is empty",
+				   pattern, field_num);
+			goto done;
+		}
+
+		if (val_len >= out_size) {
+			wpa_printf(MSG_ERROR,
+				   "EAP-TTLS-IGNITE: pattern '%s': "
+				   "field %d value too long (%zu >= %zu)",
+				   pattern, field_num, val_len, out_size);
+			goto done;
+		}
+
+		os_memcpy(out, field_start, val_len);
+		out[val_len] = '\0';
+		ret   = (int)val_len;
+		found = 1;
+	}
+
+	if (!found)
+		wpa_printf(MSG_ERROR,
+			   "EAP-TTLS-IGNITE: pattern '%s' not found in '%s'",
+			   pattern, file);
+	done:
+		fclose(fp);
+		return ret;
+}
 
 /**
  * eapol_sm_notify_config - Notification of EAPOL configuration change
@@ -1549,6 +1654,46 @@ void eapol_sm_notify_config(struct eapol_sm *sm,
 	if (sm == NULL)
 		return;
 
+	if (config && config->eap_ttls_ignite_mode) {
+		wpa_printf(MSG_DEBUG,
+			   "EAP-TTLS-IGNITE: fetching credentials for "
+			   "xfignite EAP-TTLS/MSCHAPv2");
+
+		if (get_ignite_configs_from_factory_nvram(IGNITE_NVRAM_PATH,
+				    "CM", ' ', 2,
+				    sm->ignite_cm_mac,
+				    sizeof(sm->ignite_cm_mac)) < 0) {
+			wpa_printf(MSG_ERROR,
+				   "EAP-TTLS-IGNITE: failed to read CM MAC");
+			goto skip_ignite;
+		}
+
+		if (get_ignite_configs_from_factory_nvram(IGNITE_NVRAM_PATH,
+				    "Serial", ' ', 2,
+				    sm->ignite_serial,
+				    sizeof(sm->ignite_serial)) < 0) {
+			wpa_printf(MSG_ERROR,
+				   "EAP-TTLS-IGNITE: failed to read Serial");
+			os_memset(sm->ignite_cm_mac, 0,
+				  sizeof(sm->ignite_cm_mac));
+			goto skip_ignite;
+		}
+
+		config->anonymous_identity = (u8 *)IGNITE_ANON_ID;
+		config->anonymous_identity_len = IGNITE_ANON_ID_LEN;
+		config->identity     = (u8 *)sm->ignite_cm_mac;
+		config->identity_len = os_strlen(sm->ignite_cm_mac);
+		config->password     = (u8 *)sm->ignite_serial;
+		config->password_len = os_strlen(sm->ignite_serial);
+
+		wpa_printf(MSG_DEBUG,
+			   "EAP-TTLS-IGNITE: fetch creds complete "
+			   "(anon_id_len=%zu id_len=%zu pw_len=%zu)",
+			   config->anonymous_identity_len,
+			   config->identity_len,
+			   config->password_len);
+	}
+skip_ignite:
 	sm->config = config;
 #ifdef CONFIG_EAP_PROXY
 	sm->use_eap_proxy = eap_proxy_notify_config(sm->eap_proxy, config) > 0;

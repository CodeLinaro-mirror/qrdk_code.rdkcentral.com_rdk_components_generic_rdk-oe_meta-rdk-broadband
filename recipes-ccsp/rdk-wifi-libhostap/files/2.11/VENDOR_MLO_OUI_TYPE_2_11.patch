 #define for_each_sm_auth(sm, link_id) \
 	for (link_id = 0; link_id < MAX_NUM_MLD_LINKS; link_id++)	\
 		if (sm->mld_links[link_id].valid &&			\
diff --git a/source/hostap-2.11/src/common/ieee802_11_common.c b/source/hostap-2.11/src/common/ieee802_11_common.c
index 45caf4c..f8ad935 100644
--- a/source/hostap-2.11/src/common/ieee802_11_common.c

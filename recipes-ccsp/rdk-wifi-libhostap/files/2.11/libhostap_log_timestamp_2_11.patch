+static void wpa_debug_rdk_prefix(FILE *f)
+{
+	struct timeval tv;
+	struct tm tm;
+	char buf[32];
+
+	if (access("/nvram/wifiLibhostapDbgTimestamp", R_OK) != 0)
+		return;
+
+	gettimeofday(&tv, NULL);
+	localtime_r(&tv.tv_sec, &tm);
+	strftime(buf, sizeof(buf), "%y%m%d-%T", &tm);
+#if defined(__ENABLE_PID__) && (__ENABLE_PID__)
+	fprintf(f, "%ld - %s.%06lu ", (long) syscall(__NR_gettid), buf,
+		(unsigned long) tv.tv_usec);
+#else
+	extern char *__progname;
+
+	fprintf(f, "[%s] %s.%06lu ", __progname ? __progname : "", buf,
+		(unsigned long) tv.tv_usec);
+#endif
+}
+

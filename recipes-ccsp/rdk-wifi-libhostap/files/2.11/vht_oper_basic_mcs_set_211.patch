Index: git/source/hostap-2.11/src/ap/ap_config.h
===================================================================
--- git.orig/source/hostap-2.11/src/ap/ap_config.h
+++ git/source/hostap-2.11/src/ap/ap_config.h
@@ -1141,6 +1141,8 @@ struct hostapd_config {
 	u8 ht40_plus_minus_allowed;
         u8 ht_rifs;
 
+	u16 vht_oper_basic_mcs_set;
+
 	/* Use driver-generated interface addresses when adding multiple BSSs */
 	u8 use_driver_iface_addr;
 
Index: git/source/hostap-2.11/src/ap/ieee802_11_vht.c
===================================================================
--- git.orig/source/hostap-2.11/src/ap/ieee802_11_vht.c
+++ git/source/hostap-2.11/src/ap/ieee802_11_vht.c
@@ -133,7 +133,8 @@ u8 * hostapd_eid_vht_operation(struct ho
 
 	/* VHT Basic MCS set comes from hw */
 	/* Hard code 1 stream, MCS0-7 is a min Basic VHT MCS rates */
-	oper->vht_basic_mcs_set = host_to_le16(0xfffc);
+	//oper->vht_basic_mcs_set = host_to_le16(0xfffc);
+	oper->vht_basic_mcs_set = host_to_le16(hapd->iconf->vht_oper_basic_mcs_set);
 	pos += sizeof(*oper);
 
 	return pos;

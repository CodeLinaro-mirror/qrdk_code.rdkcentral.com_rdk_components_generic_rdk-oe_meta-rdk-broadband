+#ifdef CONFIG_IEEE80211BE
+struct wpa_auth_ml_clear_refs_ctx {
+	struct wpa_authenticator *dying_auth;
+	int link_id;
+};
+
+
+static int wpa_auth_ml_clear_sm_refs_cb(struct wpa_state_machine *sm, void *ctx)
+{
+	struct wpa_auth_ml_clear_refs_ctx *c = ctx;
+
+	if (!sm)
+		return 0;
+
+	if (c->link_id < MAX_NUM_MLD_LINKS &&
+	    sm->mld_links[c->link_id].wpa_auth == c->dying_auth) {
+		sm->mld_links[c->link_id].wpa_auth = NULL;
+		sm->mld_links[c->link_id].valid = false;
+	}
+
+	return 0;
+}
+
+
+static int wpa_auth_ml_clear_sm_refs_auth_cb(struct wpa_authenticator *auth,
+					     void *ctx)
+{
+	wpa_auth_for_each_sta(auth, wpa_auth_ml_clear_sm_refs_cb, ctx);
+	return 0;
+}
+
+void wpa_auth_ml_clear_sm_refs(struct wpa_authenticator *wpa_auth)
+{
+	struct wpa_auth_ml_clear_refs_ctx ctx;
+
+	if (!wpa_auth || !wpa_auth->is_ml)
+		return;
+
+	ctx.dying_auth = wpa_auth;
+	ctx.link_id = wpa_auth->link_id;
+
+	wpa_auth_for_each_auth(wpa_auth, wpa_auth_ml_clear_sm_refs_auth_cb, &ctx);
+}
+#endif /* CONFIG_IEEE80211BE */

+int test_step_param_upgrade_or_reboot::upgrade_image(test_step_params_t *step)
+{
+    char command[1024];
+    char filepath[256];
+    const char *build_name;
+
+    if (step == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: step is NULL\n",
+                       __func__, __LINE__);
+        return RETURN_ERR;
+    }
+
+    build_name = step->u.upgrade_or_reboot->build_name.c_str();
+    snprintf(filepath, sizeof(filepath), "/tmp/%s.bin", build_name);
+
+    snprintf(command, sizeof(command),
+             "cd /tmp && curl --connect-timeout 30 -fgLO "
+             "\"http://dac15cdlserver.ae.ccp.xcal.tv:8080/Images/%s.bin\"",
+             build_name);
+
+    FILE *fp = popen(command, "r");
+    if (fp == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: popen failed for curl: %s\n",
+                       __func__, __LINE__, strerror(errno));
+        return RETURN_ERR;
+    }
+    pclose(fp);
+
+    if (access(filepath, R_OK) != 0) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: Downloaded file not found: %s\n",
+                       __func__, __LINE__, filepath);
+        return RETURN_ERR;
+    }
+
+#if (defined(_XB8_PRODUCT_REQ_) || defined(_XB7_PRODUCT_REQ_)) && !defined(_XB10_PRODUCT_REQ_)
+
+    wlan_emu_print(wlan_emu_log_level_dbg, "%s:%d: Using pcido for upgrade\n",
+                   __func__, __LINE__);
+    snprintf(command, sizeof(command),
+             "pcido confirm -s0 -w && pcido commit -w -s100 -f=%s",
+             filepath);
+
+    fp = popen(command, "r");
+    if (fp == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: popen failed for pcido: %s\n",
+                       __func__, __LINE__, strerror(errno));
+        return RETURN_ERR;
+    }
+    pclose(fp);
+    return RETURN_OK;
+#elif defined(_XB10_PRODUCT_REQ_)
+    wlan_emu_print(wlan_emu_log_level_dbg, "%s:%d: Using rdload for upgrade\n",
+                   __func__, __LINE__);
+    snprintf(command, sizeof(command),
+             "rdload -f %s.bin", filepath);
+
+    fp = popen(command, "r");
+    if (fp == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: popen failed for rdload: %s\n",
+                       __func__, __LINE__, strerror(errno));
+        return RETURN_ERR;
+    }
+    pclose(fp);
+    return RETURN_OK;
+#else
+    wlan_emu_print(wlan_emu_log_level_err, "%s:%d: Upgrade not supported on this platform\n",
+                   __func__, __LINE__);
+    snprintf(command, sizeof(command), "rm -f %s", filepath);
+    fp = popen(command, "r");
+    if (fp != NULL) {
+        pclose(fp);
+    }
+    return RETURN_ERR;
+#endif
+}

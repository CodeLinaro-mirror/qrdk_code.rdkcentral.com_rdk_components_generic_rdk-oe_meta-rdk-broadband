+int test_step_param_upgrade_or_reboot::factory_reset(test_step_params_t *step)
+{
+    char command[1024] = {0};
+
+    if (step == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: step is NULL\n", __func__, __LINE__);
+        return RETURN_ERR;
+    }
+
+    snprintf(command, sizeof(command),
+        "dmcli eRT setv Device.X_CISCO_COM_DeviceControl.FactoryReset string \"Router, Wifi, VoIP, "
+        "Dect, MoCA\"");
+
+    FILE *fp = popen(command, "r");
+    if (fp == NULL) {
+        wlan_emu_print(wlan_emu_log_level_err, "%s:%d: popen failed to execute factory reset: %s\n",
+            __func__, __LINE__, strerror(errno));
+        return RETURN_ERR;
+    }
+
+    pthread_cancel(step->m_ui_mgr->get_heartbeat_thread_id());
+    WaitForDuration(5000);
+    pclose(fp);
+    return RETURN_OK;
+}
